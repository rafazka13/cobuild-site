# exercise-gifs configuration. Copy to .env and load it with your process manager
# (or `set -a; . ./.env; set +a`). Every value below is optional except the API key
# when EXERCISE_GIF_BACKEND=openai. Unset variables keep the defaults shown.

# --- OpenAI ------------------------------------------------------------------
# Required for the openai backend. EXERCISE_GIF_OPENAI_API_KEY is also accepted
# if you want a key dedicated to this service.
OPENAI_API_KEY=sk-...

# --- Backend & models ----------------------------------------------------------
# openai | synthetic   (synthetic = offline stick figures for tests and dry runs)
EXERCISE_GIF_BACKEND=openai
# GPT image model that draws the sprite sheets.
EXERCISE_GIF_IMAGE_MODEL=gpt-image-2
# low | medium | high | xhigh | max | auto   (sheet cost and detail; part of the cache key)
EXERCISE_GIF_IMAGE_QUALITY=medium
# auto | low   (OpenAI image moderation strictness for images.generate)
EXERCISE_GIF_IMAGE_MODERATION=auto
# auto | library | llm   (auto = curated library first, GPT planner for unknown exercises)
EXERCISE_GIF_PLANNER=auto
# Text model used by the structured-output keyframe planner.
EXERCISE_GIF_PLANNER_MODEL=gpt-5.4-mini

# --- Look ----------------------------------------------------------------------
# flat | clay | photo
EXERCISE_GIF_STYLE=flat
# Free-text description of the athlete to draw (default: a neutral adult athlete).
#EXERCISE_GIF_ATHLETE=a tall adult athlete with a long ponytail, wearing a navy tank top and black leggings
# Path to a PNG/JPG of your mascot or athlete; every sheet is drawn from it with images.edit.
#EXERCISE_GIF_REFERENCE_IMAGE=/srv/assets/mascot.png
# Keyframe grid as columns x rows (each 1-4, product 2-12). 3x2 = six keyframes.
EXERCISE_GIF_GRID=3x2

# --- GIF assembly --------------------------------------------------------------
# Output GIF is square, this many pixels per side (64-1024).
EXERCISE_GIF_FRAME_SIZE=480
# Milliseconds per frame (20-2000).
EXERCISE_GIF_FRAME_MS=140
# Dwell on the two turnaround poses of a ping-pong loop (0-5000). Default: 2 x FRAME_MS.
#EXERCISE_GIF_HOLD_ENDS_MS=280
# Colours in the shared GIF palette (2-256).
EXERCISE_GIF_COLORS=128
# Snap panel boundaries onto the separator lines the model actually drew.
EXERCISE_GIF_SNAP_GRID=true

# --- Storage & execution ---------------------------------------------------------
# Two-level cache (sheets/ and gifs/). Keep this on a persistent volume in production.
EXERCISE_GIF_CACHE_DIR=~/.cache/exercise-gifs
# Where finished <slug>.gif files are copied for the bot to send.
EXERCISE_GIF_OUTPUT_DIR=exercise-gifs-out
# Parallel image-model calls per session.
EXERCISE_GIF_MAX_WORKERS=4
# Sheet re-draws allowed when the model leaves panels blank.
EXERCISE_GIF_MAX_ATTEMPTS=2
# Seconds to wait for one image-model call (the planner uses min(this, 120)).
EXERCISE_GIF_REQUEST_TIMEOUT=180
